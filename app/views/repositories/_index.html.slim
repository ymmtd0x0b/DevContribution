- content_for :js do
  = javascript_import_module_tag 'repository-update-button'
  = javascript_import_module_tag 'repository-delete-button'
  = javascript_import_module_tag 'repository-selector'

.flex.flex-row.items-center.py-4.px-3
  = collection_select :repository, :id, registed_repositories, :id, :name, {}, class: 'select select-bordered text-lg py-0'

  #repository-update-button.btn.bg-white.border-gray-300.ml-3
    i.fa-solid.fa-arrow-rotate-right.fa-rotate-270
    = link_to '最新情報へ更新', repository_path(repository), data: { turbo_method: :patch, turbo_confirm: '本当に実行しますか？' }

  #repository-delete-button.btn.bg-white.border-gray-300.ml-3.hover:bg-error.hover:text-white
    i.fa-solid.fa-minus
    = link_to '削除', collaboration_path(collaboration), data: { turbo_method: :delete, turbo_confirm: 'このリポジトリの登録を解除しますか？' }

  = link_to new_collaboration_path, class: 'btn bg-white border border-gray-300 ml-auto' do
    i.fa-solid.fa-plus
    | 新しいリポジトリを追加

/ # ラベル更新確認用
/ .mb-3
/   - repository.labels.each do |label|
/     .ml-3
/       = label.name
