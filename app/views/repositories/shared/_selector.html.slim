.flex.gap-x-3.py-4.px-4.w-full.mx-auto.max-w-screen-lg
  .grid.grid-cols-7.gap-4
    = collection_select :repository, :id, registed_repositories, :id, :name, {}, { class: 'col-span-4 block py-1 text-lg font-semibold text-slate-700 bg-transparent border-0 border-b-2 border-blue-400 appearance-none dark:text-gray-400 dark:border-gray-700 focus:outline-none focus:ring-0 focus:border-blue-400 peer', data: { controller: 'selector', action: 'selector#change' } }
    = link_to new_registration_path, class: 'h-9 flex items-center text-gray-50 bg-blue-600 border border-blue-700 text-gray-50 dark:text-gray-50 hover:bg-blue-800 focus:ring-4 focus:ring-gray-300 font-bold rounded-lg text-sm px-4 lg:px-5 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800' do
      i.fa-solid.fa-plus.mr-1
      | 追加
    = link_to repository_path(repository), data: { turbo_method: :patch, turbo_confirm: 'このリポジトリを最新情報へ更新しますか？' }, class: 'h-9 flex items-center text-gray-800 bg-gray-50 border border-gray-300 dark:text-gray-50 hover:bg-gray-200 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 lg:px-5 lg:py-2.5 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800' do
      i.fa-solid.fa-arrow-rotate-right.fa-rotate-270.mr-1
      | 更新
    = link_to registration_path(registration), data: { turbo_method: :delete, turbo_confirm: 'このリポジトリを解除しますか？' }, class: 'h-9 flex items-center font-semibold text-gray-100 bg-rose-500 border border-rose-600 dark:text-gray-50 hover:bg-rose-600 focus:ring-4 focus:ring-gray-300 font-semibold rounded-lg text-sm px-4 lg:px-5 lg:py-2.5 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800' do
      i.fa-solid.fa-minus.mr-1
      | 削除
