.flex.gap-x-3.py-4.pl-2.w-full.mx-auto.max-w-screen-xl
  = collection_select :repository, :id, registed_repositories, :id, :name, {}, { class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-fit p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500', data: { controller: 'selector', action: 'selector#change' } }
  = link_to new_registration_path, class: 'text-white bg-blue-600 border border-blue-700 text-gray-50 dark:text-white hover:bg-blue-800 focus:ring-4 focus:ring-gray-300 font-bold rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800' do
    i.fa-solid.fa-plus.mr-1
    | 追加
  = link_to repository_path(repository), data: { turbo_method: :patch, turbo_confirm: 'このリポジトリを最新情報へ更新しますか？' }, class: 'text-gray-800 bg-gray-50 border border-gray-300 dark:text-white hover:bg-gray-200 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800' do
    i.fa-solid.fa-arrow-rotate-right.fa-rotate-270.mr-1
    | 更新
  = link_to registration_path(registration), data: { turbo_method: :delete, turbo_confirm: 'このリポジトリを解除しますか？' }, class: 'text-gray-800 bg-rose-500 border border-rose-600 text-white dark:text-white hover:bg-rose-600 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800' do
    i.fa-solid.fa-minus.mr-1
    | 削除
