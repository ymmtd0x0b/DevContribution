.flex.px-4.w-full.mx-auto.max-w-screen-lg
  .mx-4.text-sm.font-semibold.text-center.text-gray-500.border-b.border-gray-300(data-controller="optimized-tabs" data-optimized-tabs-active-tab-class="text-blue-600 border-blue-600 rounded-t-lg active" data-optimized-tabs-inactive-tab-class="border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300")
    ul.list-reset.flex.flex-wrap.pl-4
      li
        = tab_to '担当した Issue', users_issues_path(@user.login, association: 'assigned')
      li
        = tab_to 'レビューした Issue', users_issues_path(@user.login, association: 'reviewed')
      li
        = tab_to '作成した Issue', users_issues_path(@user.login)
      li
        = tab_to '作成した Wiki', users_wikis_path(@user.login)
      li
        = tab_to '全て表示', users_contributions_path(@user.login)
