.max-w-screen-lg.mx-auto
  .mx-4.text-sm.font-semibold.text-center.text-gray-500.border-b.border-gray-300(data-controller="tabs" data-tabs-active-tab-class="border-blue-600 rounded-t-lg active")
    ul.flex.flex-wrap.pl-4.list-reset
      li.me-2(data-index="1" data-tabs-target="tab" data-action="click->tabs#change")
        = tab_to '担当した Issue', users_issues_path(@user.login, association: 'assigned')
      li.me-2(data-index="2" data-tabs-target="tab" data-action="click->tabs#change")
        = tab_to 'レビューした Issue', users_issues_path(@user.login, association: 'reviewed')
      li.me-2(data-index="3" data-tabs-target="tab" data-action="click->tabs#change")
        = tab_to '作成した Issue', users_issues_path(@user.login)
      li.me-2(data-index="4" data-tabs-target="tab" data-action="click->tabs#change")
        = tab_to '作成した Wiki', users_wikis_path(@user.login)
      li.me-2(data-index="5" data-tabs-target="tab" data-action="click->tabs#change")
        = tab_to '全て表示', users_contributions_path(@user.login)
