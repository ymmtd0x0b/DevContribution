.flex.gap-x-3.py-6.px-4.w-full.mx-auto.max-w-screen-lg
  .flex.items-center.space-x-3
    .flex.items-center
      .w-8.h-8.rounded.mr-1
        - if repository.avatar_url?
          = image_tag repository.avatar_url
        - else
          = image_tag 'github.svg'
      .ml-1.py-1.text-ms.font-semibold.text-slate-700
        = repository.name
    .flex.text-ms.text-slate-700
      .font-medium
        | での
      .px-1.mx-1.font-semibold.text-blue-600.border-0.border-b-2.border-blue-600
        - if user == current_user
          | あなた
        - else
          = "#{user.login} さん"
      .font-medium
        | の取り組み
    - if user == current_user
      = button_to repository_path, form: { id: 'repository_update_button' }, method: :patch,
                                    data: { turbo_confirm: '更新を実行しますか？', turbo_frame: '_top' },
                                    class: 'h-9 flex items-center text-gray-800 bg-white border border-gray-300 hover:bg-gray-200 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 focus:outline-none' do
        i.fa-solid.fa-arrow-rotate-right.fa-rotate-270.mr-1
        | 最新情報へ更新


