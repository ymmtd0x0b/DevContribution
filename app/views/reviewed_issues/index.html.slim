h3.ml-3.my-2.has-text-left.is-size-4
  = @repository.name

nav.panel
  p.panel-tabs.is-justify-content-left.ml-3.is-size-6
    = link_to '担当 Issue',     repository_assigned_issues_path(@repository)
    = link_to 'レビュー Issue', repository_reviewed_issues_path(@repository), class: 'is-active'
    = link_to '作成 Issue',     '#'
    = link_to '作成 Wiki',      '#'
  .main-panel.has-background-grey-lighter.px-5.pt-5.pb-3.m-0
    - @reviewed_issues.each do |reviewed_issue|
      .has-background-white.mb-3
        a.panel-block.has-text-left.is-size-6
          = reviewed_issue.title
