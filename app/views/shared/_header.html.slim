header
  nav.py-2.bg-slate-600.dark:bg-gray-800
    .flex.flex-wrap.justify-between.items-center.px-4.py-2.5.mx-auto.max-w-screen-lg
      = link_to root_path, class: 'flex items-center text-white' do
        span.self-center.text-xl.font-semibold.whitespace-nowrap.dark:text-white
          | DevContribution
      .flex.items-center.lg:order-2
        - if logged_in?
          button#dropdownUserAvatarButton(data-dropdown-toggle='dropdownAvatarName' class='flex items-center text-sm pe-1 font-medium text-white rounded-full hover:text-blue-600 dark:hover:text-blue-500 md:me-0 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:text-white' type='button')
            = image_tag current_user.image_url, class: 'w-8 h-8 me-2 rounded-full'
            = current_user.name
            = icon('drop_down', { class: 'w-2.5 h-2.5 ms-3' })
          #dropdownAvatarName.z-10.hidden.bg-gray-500.text-gray-50.font-semibold.divide-y.divide-gray-100.rounded-lg.shadow.w-52.dark:bg-gray-700.dark:divide-gray-600
            .py-2
              = link_to retirement_path, data: { turbo_method: :post, turbo_confirm: '本当に実行してもよろしいですか？' }, class: 'block px-4 py-2 text-sm hover:bg-red-500 dark:hover:bg-gray-600 dark:hover:text-white' do
                i.fa-solid.fa-trash-can.pr-2
                | アカウントを削除
            .py-2
              = link_to logout_path, data: { turbo_method: :delete }, class: 'block px-4 py-2 text-sm hover:bg-gray-400 dark:hover:bg-gray-600 dark:hover:text-white' do
                i.fa-solid.fa-arrow-right-from-bracket.pr-2
                | ログアウト
        - else
          = form_tag '/auth/github', method: :post, data: { turbo: false } do
            = button_tag 'ログイン', class: 'text-gray-800 bg-gray-50 dark:text-white hover:bg-gray-200 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 mr-2 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800'
