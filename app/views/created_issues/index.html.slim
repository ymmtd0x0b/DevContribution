h3.pl-3.py-2.has-text-left.is-size-4
  = @repository.name

nav.panel.has-background-grey-lighter
  p.panel-tabs.has-background-white.is-justify-content-left.pl-3.is-size-6
    = link_to '担当 Issue',     repository_assigned_issues_path(@repository)
    = link_to 'レビュー Issue', repository_reviewed_issues_path(@repository)
    = link_to '作成 Issue',     repository_created_issues_path(@repository), class: 'is-active'
    = link_to '作成 Wiki',      '#'
  .main-panel.px-5.pt-5.pb-3.m-0
    - @created_issues.each do |created_issue|
      .has-background-white.mb-3
        a.panel-block.has-text-left.is-size-6
          = created_issue.title
