/ .main-panel.px-5.pt-5.pb-3.my-0
.bg-indigo-50.h-full.px-10.pt-5.pb-3.my-0
  .max-w-4xl.mx-auto.py-3
    .w-fit.ml-auto
      .button#clipboard_write_button
        i.fa-regular.fa-copy
        | マークダウンでコピーする

    .deliverable-container
      .bg-gray-200.border.border-black.py-3.px-2.mx-auto.my-3
        section.bg-white.pt-3.pb-5.px-4
          h2.is-size-4 Pull Request

          table.table.is-bordered.is-striped.is-hoverable.is-fullwidth
            thead
              tr
                th Point
                th Issue
                th PR
            tbody
              - @assigned_issues.each do |assigned_issue|
                tr
                  td = assigned_issue.point
                  td = assigned_issue.title
                  td #000
              tr
                td = @assigned_issues.sum { |issue| issue.point }
                td total
                td

        section.bg-white.pt-3.pb-5.px-4
          h2.is-size-4 Review
          table.table.is-bordered.is-striped.is-fullwidth
            thead
              tr
                th Point
                th Issue
                th PR
            tbody
              - @reviewed_issues.each do |reviewed_issue|
                tr
                  td = reviewed_issue.point
                  td = reviewed_issue.title
                  td #000

        section.bg-white.pt-3.pb-5.px-4
          h2.is-size-4 その他

          .sub-section.pt-4
            h3.font-semibold.is-size-4.pb-2 Issue
            | バグ発見の報告や改善提案等に関して、私が作成した Issue です。

            ul.menu-list.pt-2.ml-5
              - @created_issues.each do |created_issue|
                  li.list-disc.py-3
                    = created_issue.title

          .sub-section.pt-4
            h3.font-semibold.is-size-4.pb-2 Wiki
            | 作業効率化・負荷低減を目的として、私が作成した Wikiページです。

            ul.menu-list.pt-2.ml-5
              - @wikis.each do |wiki|
                  li.list-disc.py-3
                    = wiki.title
